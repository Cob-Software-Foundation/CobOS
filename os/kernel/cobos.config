# CobOS kernel config fragment: a small x86_64 kernel that can run a Wayland session.
#
# Merged over x86_64_defconfig by os/build.sh. To do it by hand:
#   make -C Kernel-Source O=/path/to/out x86_64_defconfig
#   Kernel-Source/scripts/kconfig/merge_config.sh -m -O /path/to/out /path/to/out/.config os/kernel/cobos.config
#   make -C Kernel-Source O=/path/to/out olddefconfig

CONFIG_LOCALVERSION="-cobos"
CONFIG_DEFAULT_HOSTNAME="cobos"

# --- Graphics: a Wayland compositor drives the display through DRM/KMS ---
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y

# --- Input: compositors read keyboards and mice through evdev ---
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_MOUSE=y
CONFIG_VIRTIO_INPUT=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# --- Userspace plumbing a Wayland session relies on ---
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_SHMEM=y
CONFIG_UNIX=y
CONFIG_UNIX98_PTYS=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_TIMERFD=y
CONFIG_SIGNALFD=y
CONFIG_MEMFD_CREATE=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# --- Boot: the root filesystem is embedded in the kernel image (set by build.sh) ---
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_VIRTIO_PCI=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
