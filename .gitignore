# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
!Makefile.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# debug information files
*.dwo

# Kernel-Source is a verbatim copy of upstream Linux, which has its own .gitignore
# files. The generic rules above (*.d, *.map, *.hex, *.x86_64, ...) must not drop
# real kernel files, so re-include everything there and let Kernel-Source's own
# rules decide.
!/Kernel-Source/**

# Output of os/build.sh (kernel build tree, root filesystem, bzImage)
/os/out/
